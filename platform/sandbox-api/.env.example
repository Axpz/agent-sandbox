# The AGENTSPHERE_ prefix is an existing compatibility contract.
# Otherwise use standard KUBECONFIG / in-cluster credentials.
# AGENTSPHERE_KUBECONFIG=/absolute/path/to/kubeconfig
AGENTSPHERE_NAMESPACE=sandbox
AGENTSPHERE_WARMPOOL=codesphere-warmpool
AGENTSPHERE_DOMAIN=sandbox.example.invalid
AGENTSPHERE_K8S_SKIP_TLS_VERIFY=false
AGENTSPHERE_ENVD_VERSION=0.6.9
AGENTSPHERE_CREATE_TIMEOUT_MS=120000
AGENTSPHERE_CREATE_POLL_MS=500
PORT=3000
LOG_LEVEL=info
