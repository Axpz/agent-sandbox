+func TestInvalidRestoreRejectedBeforeCreate(t *testing.T) {
+	for _, kind := range []string{"empty path", "relative path", "missing", "empty file", "directory"} {
+		t.Run(kind, func(t *testing.T) {
+			path := t.TempDir()
+			switch kind {
+			case "empty path":
+				path = ""
+			case "relative path":
+				path = "relative/checkpoint"
+			case "empty file":
+				if err := os.WriteFile(filepath.Join(path, "checkpoint.img"), nil, 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "directory":
+				if err := os.Mkdir(filepath.Join(path, "checkpoint.img"), 0700); err != nil {
+					t.Fatal(err)
+				}
+			}
+			bundle := t.TempDir()
+			spec := &specs.Spec{Annotations: map[string]string{RestoreHostPathAnnotation: path}}
+			if err := utils.WriteSpec(bundle, spec); err != nil {
+				t.Fatal(err)
+			}
+			// No platform or runtime is initialized: validation must happen first.
+			s := &runscService{}
+			if _, err := s.Create(t.Context(), &task.CreateTaskRequest{ID: "test", Bundle: bundle}); err == nil || !strings.Contains(err.Error(), "restore") {
+				t.Fatalf("Create invalid restore: %v", err)
+			}
+			if len(s.containers) != 0 {
+				t.Fatal("invalid restore created a container")
+			}
+		})
+	}
+}
