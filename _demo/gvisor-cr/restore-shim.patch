+func TestPendingRestore(t *testing.T) {
+	for _, tc := range []struct {
+		name, path, execID string
+		want               bool
+	}{
+		{name: "cold start"},
+		{name: "restore missing image must not cold start", path: "/missing/checkpoint", want: true},
+		{name: "exec is not restore", path: "/missing/checkpoint", execID: "exec"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			c := &Container{restoreHostImagePath: tc.path}
+			path, got := c.pendingRestore(tc.execID)
+			if got != tc.want || (got && path != tc.path) {
+				t.Fatalf("pendingRestore(%q) = (%q, %v), want restore=%v", tc.execID, path, got, tc.want)
+			}
+		})
+	}
+}
