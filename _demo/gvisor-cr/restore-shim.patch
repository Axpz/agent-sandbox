+func TestFailedSandboxRestoreStopsTask(t *testing.T) {
+	p := proc.New("test", &runsccmd.Runsc{Command: filepath.Join(t.TempDir(), "missing-runsc")}, stdio.Stdio{})
+	p.Sandbox = true
+	p.Platform = &linuxPlatform{}
+	if err := p.Restore(t.Context(), &extension.RestoreConfig{ImagePath: t.TempDir()}); err == nil {
+		t.Fatal("restore unexpectedly succeeded")
+	}
+	if state, err := p.Status(t.Context()); err != nil || state != "stopped" {
+		t.Fatalf("failed restore status = %q, %v; want stopped", state, err)
+	}
+	if err := p.Kill(t.Context(), 9, true); err != nil {
+		t.Fatalf("failed restore cannot be stopped: %v", err)
+	}
+	done := make(chan struct{})
+	go func() {
+		p.Wait()
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("failed restore leaves Wait blocked")
+	}
+}
