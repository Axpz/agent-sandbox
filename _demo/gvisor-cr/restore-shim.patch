+func validateRestorePath(path string) error {
+	if !filepath.IsAbs(path) {
+		return fmt.Errorf("restore image path must be absolute: %q", path)
+	}
+	statePath := filepath.Join(path, "checkpoint.img")
+	info, err := os.Stat(statePath)
+	if err != nil {
+		return fmt.Errorf("validate restore checkpoint: %w", err)
+	}
+	if !info.Mode().IsRegular() || info.Size() == 0 {
+		return fmt.Errorf("restore checkpoint must be a nonempty regular file: %q", statePath)
+	}
+	return nil
+}
+
+func stripGVisorRestoreAnnotations(spec *specs.Spec) {
+	if spec == nil {
+		return
+	}
+	for key := range spec.Annotations {
+		if strings.HasPrefix(key, restoreAnnotationPrefix) {
+			delete(spec.Annotations, key)
+		}
+	}
+}
