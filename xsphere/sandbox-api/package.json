{
  "name": "sandbox-api",
  "version": "0.0.1",
  "description": "e2b-compatible control-plane API for codesphere sandboxes, backed by kubernetes-sigs/agent-sandbox",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.2",
    "@kubernetes/client-node": "^1.4.0",
    "hono": "^4.13.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "^1.3.14",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "yaml": "2.9.0"
  }
}
