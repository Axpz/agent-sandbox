{
  "annotations": {
    "list": []
  },
  "description": "单个 Sandbox 拥有的 Pod 的资源与状态。全部取自 Pod 级 cgroup 与 kube-state-metrics，沙箱内部进程、envd 自身指标不在此面板范围内。内存 pause/resume 会重建 Pod，重建前后的采样之间是断点。",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 101,
      "title": "身份与状态",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Pod 的 Ready condition。Sandbox 自身的 condition 不在 kube-state-metrics 里，这里反映的是它当前 Pod 的就绪性。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#2e9e6b",
            "mode": "fixed"
          },
          "decimals": 0,
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "#c0392b",
                  "index": 0,
                  "text": "未就绪"
                },
                "1": {
                  "color": "#2e9e6b",
                  "index": 1,
                  "text": "就绪"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "无该 Pod",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 102,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max(kube_pod_status_ready{namespace=\"$ns\", pod=\"$sandbox\", condition=\"true\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "就绪状态",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "从当前 Pod 创建至今。内存 pause/resume 会重建 Pod，所以这个值在 resume 后归零，并不代表沙箱寿命。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#3987e5",
            "mode": "fixed"
          },
          "decimals": 0,
          "mappings": [],
          "noValue": "窗口内无样本",
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 103,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "time() - max(kube_pod_created{namespace=\"$ns\", pod=\"$sandbox\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "当前 Pod 存活时长",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "当前 Pod 内容器的重启计数。Pod 被重建后该计数随新 Pod 归零。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#d9a326",
            "mode": "fixed"
          },
          "decimals": 0,
          "mappings": [],
          "noValue": "窗口内无样本",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 104,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"$ns\", pod=\"$sandbox\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "容器重启次数",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "取自 kube_pod_info 与 kube_pod_owner。owner 是 Sandbox 资源名；Sandbox 到 SandboxClaim 的归属关系不在 kube-state-metrics 中，此处无法展示。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "noValue": "无该 Pod"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 105,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "kube_pod_info{namespace=\"$ns\", pod=\"$sandbox\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "INFO"
        }
      ],
      "title": "身份",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "container": true,
              "created_by_kind": true,
              "endpoint": true,
              "host_ip": true,
              "host_network": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "priority_class": true,
              "service": true
            },
            "indexByName": {},
            "renameByName": {
              "created_by_name": "owner",
              "node": "节点",
              "pod": "Pod",
              "pod_ip": "Pod IP",
              "uid": "Pod UID"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 106,
      "title": "资源",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Pod 根 cgroup 的工作集，不是进程堆大小，也不是快照大小。沙箱 Pod 没有设置资源上限，因此没有上限参考线。Pod 被重建后同名沙箱仍在同一条序列上，缺失的采样保留为断点；只有断点不能证明沙箱被挂起。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 8,
            "showPoints": "always",
            "spanNulls": false
          },
          "mappings": [],
          "noValue": "窗口内无样本",
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "工作集"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#3987e5",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "id": 107,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"$ns\", pod=\"$sandbox\", container=\"\", image=\"\", name=\"\"})",
          "legendFormat": "工作集",
          "refId": "A"
        }
      ],
      "title": "内存工作集",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Pod 根 cgroup 的 CPU 使用率，单位为核。gVisor 的 sentry 开销也计入其中。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 8,
            "showPoints": "always",
            "spanNulls": false
          },
          "decimals": 3,
          "mappings": [],
          "noValue": "窗口内无样本",
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "使用"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#3987e5",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "id": 108,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"$ns\", pod=\"$sandbox\", container=\"\", image=\"\", name=\"\"}[$__rate_interval]))",
          "legendFormat": "使用",
          "refId": "A"
        }
      ],
      "title": "CPU 使用（核）",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Pod 根 cgroup 的块设备吞吐。部分从快照恢复的 Pod 没有块设备计数，此面板会显示无样本——那不等于没有 I/O。工作区读写也可能落在 PVC 的宿主文件系统上。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 8,
            "showPoints": "always",
            "spanNulls": false
          },
          "mappings": [],
          "noValue": "该 Pod 无块设备计数",
          "unit": "Bps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "读"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#3987e5",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "写"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#d95926",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 109,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(container_fs_reads_bytes_total{namespace=\"$ns\", pod=\"$sandbox\", container=\"\", image=\"\", name=\"\"}[$__rate_interval]))",
          "legendFormat": "读",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(container_fs_writes_bytes_total{namespace=\"$ns\", pod=\"$sandbox\", container=\"\", image=\"\", name=\"\"}[$__rate_interval]))",
          "legendFormat": "写",
          "refId": "B"
        }
      ],
      "title": "磁盘读写速率",
      "type": "timeseries"
