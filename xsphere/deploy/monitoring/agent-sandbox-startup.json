    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "所选命名空间内已完成的 HTTP 请求，按所选时间范围计算，不含后台自动暂停或未完成请求。success 为 2xx，client_error 为 4xx，server_error 为 5xx。connect 包含连接已运行沙箱，不能等同于内存恢复次数；次数是 Prometheus 增量估计。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#3987e5",
            "mode": "fixed"
          },
          "decimals": 0,
          "noValue": "未采集",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 34
      },
      "id": 16,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(sandbox_api_lifecycle_request_duration_seconds_count{namespace=\"$resource_namespace\", operation=\"pause\", result=\"success\"}[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Pause 成功请求（约）",
