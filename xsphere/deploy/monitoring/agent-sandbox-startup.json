      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 8,
            "showPoints": "auto",
            "spanNulls": false
          },
          "decimals": 0,
