          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(agent_sandboxes{ready_condition=\"true\", expired=\"false\", sandbox_template=~\"$template\"})",
          "legendFormat": "就绪",
          "refId": "A"
        },
        {
          "datasource": {
